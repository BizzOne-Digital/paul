# MongoDB connection (required)
MONGODB_URI=mongodb://127.0.0.1:27017/bc_winery_buyer

# Session signing secret — use a long random string in production (min 32 chars)
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Seeded admin credentials (used by npm run seed only)
ADMIN_EMAIL=admin@bcwinerybuyer.com
ADMIN_PASSWORD=Admin123!Secure

# Public contact email (footer, contact page — overrides MongoDB when set)
SITE_CONTACT_EMAIL=bcwineriesforsale@gmail.com

# Public site URL for sitemap, canonical links, and Open Graph (required in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Node environment (set to production on live server)
# NODE_ENV=production
